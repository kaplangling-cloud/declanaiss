# ------------------------------------------------------------------
# Declaration de naissance en ligne - variables d'environnement
# Copier en .env et renseigner. NE JAMAIS COMMITER LE .env
# ------------------------------------------------------------------

# --- Général ---
NODE_ENV=development
APP_NAME="Declaration de Naissance"
APP_PUBLIC_URL=http://localhost:8080
TZ=Africa/Douala

# --- PostgreSQL (service "postgres" du docker-compose) ---
POSTGRES_USER=declanaiss
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=declanaiss
POSTGRES_PORT=5432
DATABASE_URL=postgresql://declanaiss:change_me_postgres@postgres:5432/declanaiss?schema=public
# Connexion des migrations Prisma. En local : identique a DATABASE_URL.
# Supabase : voir docs/deploiement-supabase-render.md (pooler en mode session, sslmode=require).
DIRECT_URL=${DATABASE_URL}
# Nombre de relais (proxys) de confiance devant l'API : 1 derriere Nginx (local, serveur) ;
# a verifier sur Render (cf. guide de deploiement).
TRUST_PROXY_HOPS=1

# --- API ---
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- JWT ---
# Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_48_bytes_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_48_bytes_minimum
JWT_REFRESH_TTL=7d

# --- Chiffrement des données sensibles au repos (AES-256-GCM) ---
# Clé 32 octets en base64 : openssl rand -base64 32
DATA_ENCRYPTION_KEY=change_me_base64_32_bytes_key_here==
# Clé HMAC pour les index aveugles (recherche sur donnée chiffrée)
BLIND_INDEX_KEY=change_me_base64_32_bytes_key_here==

# --- Règles métier ---
# Fenêtre de modification après soumission (jours calendaires)
MODIFICATION_WINDOW_DAYS=7
# Cron de verrouillage automatique (toutes les heures)
LOCK_CRON=0 * * * *

# --- Stockage des pièces jointes et des PDF ---
STORAGE_ROOT=/var/lib/declanaiss/storage
MAX_UPLOAD_SIZE_MB=8


# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Frontend (build-time, prefixe VITE_) ---
VITE_API_URL=/api
VITE_APP_NAME="Declaration de Naissance"

# --- Nginx / HTTPS (production) ---
SERVER_NAME=declaration.example.cm
CERTBOT_EMAIL=admin@example.cm
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Sauvegardes ---
BACKUP_DIR=/var/backups/declanaiss
BACKUP_RETENTION_DAYS=3650
BACKUP_GPG_RECIPIENT=
