# Copier en .env.supabase (non versionne) et renseigner depuis Supabase :
#   Project Settings > Database > Connection string > « Session pooler »
# Le pooler en mode session est compatible IPv4 (Render) et garde les verrous
# consultatifs et les instructions preparees utilises par l'application.
# Remplacer [MOT-DE-PASSE] par le mot de passe de la base (encoder les caracteres
# speciaux : @ -> %40, # -> %23, / -> %2F...).

DATABASE_URL=postgresql://postgres.[REF-PROJET]:[MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[REF-PROJET]:[MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Premier administrateur national (creation unique, script prisma/creer-admin.ts)
ADMIN_EMAIL=
ADMIN_USERNAME=
